<?xml version="1.0"?>
<interface>

  <menu id="ActionsPlaceholder0">
    <submenu>
      <attribute name="label" translatable="yes">_Posting</attribute>
      <attribute name="action">gnc-plugin-se-actions.SeMenuAction</attribute>
      <section>
        <item>
          <attribute name="label" translatable="yes">_Post Through…</attribute>
          <attribute name="action">gnc-plugin-se-actions.SeLockAction</attribute>
          <attribute name="tooltip" translatable="yes">Post the preliminary transactions up to a date: number them and lock them</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Close _Fiscal Year…</attribute>
          <attribute name="action">gnc-plugin-se-actions.SeCloseYearAction</attribute>
          <attribute name="tooltip" translatable="yes">Post everything up to the last day of the fiscal year and mark the year closed</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Check Voucher Series</attribute>
          <attribute name="action">gnc-plugin-se-actions.SeVerifyAction</attribute>
          <attribute name="tooltip" translatable="yes">Check that the voucher series are unbroken and that no posted transaction has been changed</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Processing _History…</attribute>
          <attribute name="action">gnc-plugin-se-actions.SeHistoryAction</attribute>
          <attribute name="tooltip" translatable="yes">Show what has been done to the book: periods posted, corrections, changed settings, accounts and tax tables</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Voucher _Series and Fiscal Year…</attribute>
          <attribute name="action">gnc-plugin-se-actions.SeSettingsAction</attribute>
          <attribute name="tooltip" translatable="yes">Set the fiscal years, the voucher series and how long posting may be put off</attribute>
        </item>
      </section>
    </submenu>
  </menu>

</interface>
